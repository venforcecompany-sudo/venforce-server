{
  "name": "venforce-frontend-react",
  "version": "1.1.0",
  "private": true,
  "description": "Migração gradual do Portal VenForce para React + Vite, com Cliente 360 V2 e Central Executiva.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-layout.mjs && vite",
    "build": "node scripts/patch-layout.mjs && node scripts/clean-assets.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:full": "vite --config vite.full.config.js",
    "build:full": "node scripts/clean-assets-full.mjs && vite build --config vite.full.config.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
